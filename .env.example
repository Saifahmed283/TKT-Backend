# TKT Backend environment
# Copy to .env and fill in real values.

# PostgreSQL (Neon) connection string
# Use pooled URL for runtime; direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/dbname?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Used by integration tests (recommend a separate Neon branch/db)
TEST_DATABASE_URL=""

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins. The deployed frontend is allowed by default;
# add preview/custom domains here when needed. Do not add the backend origin.
CORS_ORIGIN=http://localhost:5173,https://ticketak.vercel.app
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For.
# Defaults to loopback in production; set this to the real proxy hop if different.
TRUST_PROXY_IPS=""

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# HMAC secret for short-lived staff ID tokens (workforce /id-token).
JWT_SECRET=""
JWT_ACCESS_TTL="1h"
JWT_REFRESH_TTL="7d"

# Credential signing keys (ed25519). Store base64url-encoded PEM:
# Generate with: node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('ed25519');console.log('priv='+k.privateKey.export({type:'pkcs8',format:'pem'}).toString('base64url'));console.log('pub='+k.publicKey.export({type:'spki',format:'pem'}).toString('base64url'))"
CREDENTIAL_PRIVATE_KEY_B64=""
CREDENTIAL_PUBLIC_KEY_B64=""

# Email delivery (reservation QR tickets, staff onboarding). When disabled, emails are logged to stdout instead.
# Leave SMTP_ENABLED unset to auto-enable when SMTP_HOST/SMTP_USER/SMTP_PASS are all present.
# Set SMTP_ENABLED=false to force off, or =true to force on.
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TKT Ops <no-reply@tkt.local>"
PUBLIC_URL="http://localhost:5173"

# Private upload storage. Required in production (serverless local disk is ephemeral).
# In development/test, leaving the token empty keeps uploads on local disk.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="uploads"
UPLOAD_MAX_BYTES=5242880

# Preferred production limiter. When absent, sensitive endpoints use the
# Postgres fallback and still fail closed on limiter errors.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cron job secret (for internal cleanup endpoints). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# Seed scripts (required; no hardcoded fallback passwords)
SEED_ADMIN_EMAIL="admin@tkt.local"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""