generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// USERS & ORGANIZATIONS
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  platformRole String? // 'super_admin' | null — platform-level role
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orgMemberships      OrganizationMember[]
  eventMemberships    EventMember[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  accessLogs          AccessLog[]                 @relation("AccessOperator")
  tasksAssigned       Task[]                      @relation("TaskAssignee")
  tasksCreated        Task[]                      @relation("TaskCreator")
  tasksCompleted      Task[]                      @relation("TaskCompleter")
  taskActivities      TaskActivity[]
  incidentsCreated    Incident[]                  @relation("IncidentCreator")
  incidentsAssigned   Incident[]                  @relation("IncidentAssignee")
  incidentComments    IncidentComment[]
  announcements       Announcement[]
  messagesSent        Message[]
  devices             Device[]
  registeredAttendees Attendee[]
  approvedTickets     Ticket[]                    @relation("TicketApprovedBy")
  paymentReviewedTickets Ticket[]                 @relation("TicketPaymentReview")
  deliveryAttempts    CredentialDeliveryAttempt[] @relation("CredentialDeliveryCreatedBy")
  issuedAccessCodes   AccessCode[]                @relation("AccessCodeIssuedBy")
  staffProfile        StaffProfile?
  workforceApplicationsSubmitted WorkforceApplication[] @relation("WorkforceSubmittedBy")
  workforceApplicationsReviewed  WorkforceApplication[] @relation("WorkforceReviewedBy")
  refreshSessions     RefreshSession[]
}

model RefreshSession {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  settings    Json?
  status      OrgStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   OrganizationMember[]
  events    Event[]
  folders   OrganizationFolder[]
  roles     Role[]
  auditLogs AuditLog[]
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrgMemberRole {
  OWNER
  ADMIN
  VIEWER
}

enum OrgMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model OrganizationMember {
  id        String          @id @default(cuid())
  orgId     String
  userId    String
  role      OrgMemberRole   @default(VIEWER)
  status    OrgMemberStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
}

model OrganizationFolder {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([orgId])
  @@unique([orgId, name])
}

// ─────────────────────────────────────────────────────────────
// RBAC — ROLES
// ─────────────────────────────────────────────────────────────

enum RoleKind {
  SYSTEM // catalog role defined in code
  ORGANIZATION // custom role defined per-organization
}

enum RoleScope {
  PLATFORM // super admin
  ORGANIZATION
  EVENT
  TEAM
  AREA
}

model Role {
  id          String    @id @default(cuid())
  orgId       String? // null → system role (platform-wide catalog)
  name        String
  code        String    @unique
  description String?
  kind        RoleKind  @default(SYSTEM)
  scope       RoleScope
  permissions Json // string[] of atomic permission codes
  system      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships EventMember[]

  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────────────────────

enum EventType {
  CONFERENCE
  CONCERT
  WEDDING
  SPORTS
  EXHIBITION
  CHARITY
  CORPORATE
  UNIVERSITY
  OTHER
}

enum EventStatus {
  DRAFT
  PLANNING
  READY
  PUBLISHED
  LIVE
  COMPLETED
  ARCHIVED
}

model Event {
  id            String      @id @default(cuid())
  orgId         String
  folderId      String?
  name          String
  slug          String?
  description   String?
  type          EventType   @default(OTHER)
  category      String?
  status        EventStatus @default(DRAFT)
  startAt       DateTime
  endAt         DateTime?
  timezone      String      @default("UTC")
  venueName     String?
  venueAddress  String?
  coverImageUrl String?
  branding      Json?
  settings      Json? // event configuration blob
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  org           Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder        OrganizationFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  members       EventMember[]
  teams         Team[]
  areas         Area[]
  attendees     Attendee[]
  ticketTypes   TicketType[]
  tickets       Ticket[]
  credentials   Credential[]
  accessLogs    AccessLog[]
  tasks         Task[]
  incidents     Incident[]
  announcements Announcement[]
  messages      Message[]
  notifications Notification[]
  auditLogs     AuditLog[]
  deliveryLogs     CredentialDeliveryAttempt[]
  paymentProviders PaymentProvider[]
  accessCodes           AccessCode[]
  devices               Device[]
  staffProfiles         StaffProfile[]
  workforceApplications WorkforceApplication[]
  webhookSubscriptions  WebhookSubscription[]
  eventInsurancePolicies EventInsurancePolicy[]
  eventMapAssets        EventMapAsset?
  opsAlerts             OpsAlert[]
  teamChatMessages      TeamChatMessage[]
  buses                 Bus[]

  @@index([orgId])
  @@index([folderId])
  @@index([status])
  @@index([startAt])
}

enum EventMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model EventMember {
  id        String            @id @default(cuid())
  eventId   String
  userId    String
  roleId    String
  teamId    String?
  status    EventMemberStatus @default(ACTIVE)
  invitedBy String?
  createdAt DateTime          @default(now())

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role         @relation(fields: [roleId], references: [id])
  team  Team?        @relation(fields: [teamId], references: [id])
  areas MemberArea[]

  @@unique([eventId, userId])
  @@index([userId])
  @@index([roleId])
  @@index([teamId])
}

// ─────────────────────────────────────────────────────────────
// TEAMS & AREAS
// ─────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members   EventMember[]
  areas     TeamArea[]
  tasks     Task[]
  incidents Incident[]

  @@unique([eventId, name])
  @@index([eventId])
}

enum AreaType {
  GATE
  HALL
  STAGE
  LOUNGE
  OFFICE
  MEDICAL
  PARKING
  EXIT
  SERVICE
  OTHER
}

enum AreaAccessPolicy {
  OPEN
  TICKETED
  VIP_ONLY
  STAFF_ONLY
  RESTRICTED
  MEDIA_ONLY
}

model Area {
  id           String           @id @default(cuid())
  eventId      String
  name         String
  description  String?
  type         AreaType         @default(OTHER)
  accessPolicy AreaAccessPolicy @default(OPEN)
  capacity     Int?
  location     Json? // {"lat":..,"lng":..,"label":"Floor 1"}
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())

  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments     MemberArea[]
  teamAssignments TeamArea[]
  tasks           Task[]
  incidents       Incident[]
  accessLogs      AccessLog[]

  @@unique([eventId, name])
  @@index([eventId])
}

model MemberArea {
  id            String @id @default(cuid())
  eventMemberId String
  areaId        String

  member EventMember @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)
  area   Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([eventMemberId, areaId])
  @@index([areaId])
}

model TeamArea {
  id     String @id @default(cuid())
  teamId String
  areaId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([teamId, areaId])
  @@index([areaId])
}

// ─────────────────────────────────────────────────────────────
// ATTENDEES, TICKETS & CREDENTIALS
// ─────────────────────────────────────────────────────────────

enum AttendeeStatus {
  INVITED
  REGISTERED
  CONFIRMED
  WAITLISTED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  BLOCKED
}

enum AttendeeType {
  ATTENDEE
  VIP
  SPEAKER
  SPONSOR
  EXHIBITOR
  MEDIA
  STAFF
  ORGANIZER
  STUDENT
  GUEST
  OTHER
}

model Attendee {
  id             String         @id @default(cuid())
  eventId        String
  name           String
  email          String?
  phone          String?
  category       String? // legacy compatibility label
  attendeeType   AttendeeType?  // additive normalized type
  status         AttendeeStatus @default(REGISTERED)
  notes          String?
  registeredById String?
  registeredAt   DateTime       @default(now())
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registeredBy User?        @relation(fields: [registeredById], references: [id])
  tickets             Ticket[]
  credentials         Credential[]
  accessLogs          AccessLog[]
  redeemedAccessCodes  AccessCode[] @relation("AccessCodeRedeemedBy")

  @@index([eventId])
  @@index([eventId, email])
}

enum TicketTier {
  STANDARD
  VIP
  PREMIUM
  EARLY_BIRD
  STUDENT
  COMPLIMENTARY
  STAFF
  SPEAKER
  SPONSOR
  OTHER
}

model TicketType {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  description String?
  category    String?   // legacy compatibility label
  tier        TicketTier? // additive normalized tier/class
  price       Decimal?  @db.Decimal(10, 2)
  currency  String    @default("EGP")
  quota       Int?
  soldCount   Int       @default(0) // Atomic counter for sold/issued tickets
  salesStartAt DateTime?
  salesEndAt   DateTime?
  isPublic    Boolean   @default(true)
  transportIncluded Boolean @default(false)
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  accessCodes AccessCode[]

  @@index([eventId])
  @@index([eventId, active, isPublic])
}

enum TicketStatus {
  ISSUED
  ACTIVE
  CANCELLED
  REFUNDED
  CONSUMED
}

enum ReservationApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ReservationPaymentStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
  BOTH
}

model PaymentProvider {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  accountName   String?
  accountNumber String?
  paymentPhone  String?
  paymentLink   String?
  instructions  String?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId, isActive])
}

enum AccessCodeType {
  VIP_GUEST
  VIP_TICKET
  INVITE
  COMP
}

enum AccessCodeStatus {
  ACTIVE
  REDEEMED
  REVOKED
  EXPIRED
}

model AccessCode {
  id                    String           @id @default(cuid())
  eventId               String
  code                  String           @unique
  type                  AccessCodeType   @default(VIP_GUEST)
  status                AccessCodeStatus @default(ACTIVE)
  fullName              String?
  email                 String?
  phone                 String?
  attendeeCategory      String?
  ticketTypeId          String?
  notes                 String?
  maxRedemptions        Int              @default(1)
  redemptionCount       Int              @default(0)
  expiresAt             DateTime?
  redeemedAt            DateTime?
  lastRedeemedAt        DateTime?
  issuedById            String?
  redeemedByAttendeeId  String?
  redeemedTicketId      String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  event              Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType         TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  issuedBy           User?       @relation("AccessCodeIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  redeemedByAttendee Attendee?   @relation("AccessCodeRedeemedBy", fields: [redeemedByAttendeeId], references: [id], onDelete: SetNull)
  redeemedTicket     Ticket?     @relation("AccessCodeRedeemedTicket", fields: [redeemedTicketId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([eventId, type])
  @@index([ticketTypeId])
  @@index([redeemedByAttendeeId])
  @@index([redeemedTicketId])
}

model Ticket {
  id                  String                    @id @default(cuid())
  eventId             String
  attendeeId          String
  ticketTypeId        String
  status              TicketStatus              @default(ISSUED)
  price               Decimal?                  @db.Decimal(10, 2)
  issuedById          String?
  issuedAt            DateTime                  @default(now())
  metadata           Json?
  reservationCode     String?                   @unique
  reservationEmail    String?
  reservationPhone    String?
  reservationName     String?
  approvalStatus      ReservationApprovalStatus @default(NONE)
  paymentStatus       ReservationPaymentStatus  @default(NOT_REQUIRED)
  deliveryChannel     DeliveryChannel           @default(EMAIL)
  approvedAt          DateTime?
  approvedById        String?
  rejectedReason      String?
  paymentReference    String?
  paymentConfirmedAt  DateTime?
  paymentProviderId   String?
  paymentAmount       Decimal?                  @db.Decimal(10, 2)
  paymentProofUrl     String?
  paymentSubmittedAt  DateTime?
  paymentReviewedAt   DateTime?
  paymentReviewedById String?
  paymentReviewNote   String?
  deliveryStatus      String?                   @default("PENDING")
  lastDeliveryAt      DateTime?
  deliveryAttempts    Int                       @default(0)
  // Secure access token (hashed) for reservation lookup — separate from public reservationCode
  accessTokenHash     String?
  accessTokenExpiresAt DateTime?

  attendee          Attendee                    @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ticketType        TicketType                  @relation(fields: [ticketTypeId], references: [id])
  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentProvider   PaymentProvider?            @relation(fields: [paymentProviderId], references: [id], onDelete: SetNull)
  credential        Credential?
  approvedBy        User?                       @relation("TicketApprovedBy", fields: [approvedById], references: [id])
  paymentReviewedBy User?                       @relation("TicketPaymentReview", fields: [paymentReviewedById], references: [id])
  deliveryLogs      CredentialDeliveryAttempt[]
  redeemedAccessCodes AccessCode[] @relation("AccessCodeRedeemedTicket")
  busSeats          BusSeat[]

  @@index([eventId])
  @@index([attendeeId])
  @@index([eventId, approvalStatus])
  @@index([eventId, paymentStatus])
  @@index([paymentProviderId])
  // Covers soldCount()'s ticketTypeId + status filter on every reservation.
  @@index([ticketTypeId, status])
  @@index([accessTokenHash])
}

enum CredentialType {
  QR
  BADGE
  NFC
  OTHER
}

enum CredentialStatus {
  ISSUED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
  CONSUMED
}

model Credential {
  id           String           @id @default(cuid())
  eventId      String
  attendeeId   String
  ticketId     String?
  type         CredentialType   @default(QR)
  shortCode    String?          @unique // Human-readable code, e.g. TKT-G45UI
  code         String           @unique // QR payload — a signed token
  status       CredentialStatus @default(ISSUED)
  validFrom    DateTime
  validUntil   DateTime?
  singleUse    Boolean          @default(true)
  allowReentry Boolean          @default(false)
  areaIds      Json? // area policy — credentials allowed here
  deviceSync   Json? // last device sync info
  issuedById   String?
  issuedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee                    @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ticket       Ticket?                     @relation(fields: [ticketId], references: [id])
  accessLogs   AccessLog[]
  deliveryLogs CredentialDeliveryAttempt[]

  @@unique([ticketId])
  @@index([eventId])
  @@index([attendeeId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// ACCESS CONTROL
// ─────────────────────────────────────────────────────────────

enum AccessResult {
  GRANTED
  DENIED
}

enum AccessReason {
  NONE
  INVALID_CREDENTIAL
  WRONG_EVENT
  WRONG_AREA
  EXPIRED
  REVOKED
  SUSPENDED
  ALREADY_USED
  OUTSIDE_TIME_WINDOW
  WRONG_TICKET_ENTITLEMENT
  INSUFFICIENT_PERMISSION
  EVENT_NOT_LIVE
  OVERRIDE
  ATTENDEE_BLOCKED
  AREA_INACTIVE
}

model AccessLog {
  id             String       @id @default(cuid())
  eventId        String
  credentialId   String?
  attendeeId     String?
  operatorUserId String?
  deviceId       String?
  areaId         String?
  result         AccessResult
  reason         AccessReason @default(NONE)
  timestamp      DateTime     @default(now())
  offline        Boolean      @default(false)
  localSignature String? // device-signed proof of a local decision
  metadata       Json?

  event      Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id])
  attendee   Attendee?   @relation(fields: [attendeeId], references: [id])
  operator   User?       @relation("AccessOperator", fields: [operatorUserId], references: [id])
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  area       Area?       @relation(fields: [areaId], references: [id])

  @@index([eventId, timestamp])
  @@index([credentialId])
  @@index([areaId])
  @@index([operatorUserId])
}

enum DeviceStatus {
  REGISTERED
  ACTIVE
  DISABLED
  REVOKED
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  KIOSK
  OTHER
}

enum DeviceNetworkStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Device {
  id              String              @id @default(cuid())
  eventId         String?
  name            String
  type            DeviceType          @default(OTHER)
  status          DeviceStatus        @default(REGISTERED)
  publicKey       String
  fingerprint     String?
  ownerId         String?
  lastSeenAt      DateTime?
  lastHeartbeatAt DateTime?
  lastIp          String?
  userAgent       String?
  appVersion      String?
  networkStatus   DeviceNetworkStatus @default(UNKNOWN)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owner      User?       @relation(fields: [ownerId], references: [id])
  accessLogs AccessLog[]

  @@unique([name, publicKey])
  @@index([eventId, status])
  @@index([ownerId])
  @@index([lastSeenAt])
}

// ─────────────────────────────────────────────────────────────
// TASKS & INCIDENTS
// ─────────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Task {
  id            String       @id @default(cuid())
  eventId       String
  teamId        String?
  assigneeId    String?
  areaId        String?
  title         String
  description   String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueAt         DateTime?
  checklist     Json? // [{done, text}]
  evidence      Json? // [{url, label}]
  completedById String?
  completedAt   DateTime?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team      Team?          @relation(fields: [teamId], references: [id])
  assignee  User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  area      Area?          @relation(fields: [areaId], references: [id])
  creator   User           @relation("TaskCreator", fields: [createdById], references: [id])
  completer User?          @relation("TaskCompleter", fields: [completedById], references: [id])
  activity  TaskActivity[]

  @@index([eventId, status])
  @@index([assigneeId])
  @@index([teamId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  action    String // CREATED, ASSIGNED, STATUS_CHANGED, CHECKLIST_UPDATED, COMPLETED
  note      String?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId])
}

enum IncidentType {
  SECURITY
  MEDICAL
  TECHNICAL
  REGISTRATION
  ATTENDEE
  CROWD
  EQUIPMENT
  OPERATIONAL
  OTHER
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model Incident {
  id             String           @id @default(cuid())
  eventId        String
  code           String // INC-0001 (per event)
  type           IncidentType     @default(OTHER)
  priority       IncidentPriority @default(MEDIUM)
  status         IncidentStatus   @default(OPEN)
  createdById    String
  assignedTeamId String?
  assignedUserId String?
  areaId         String?
  title          String
  description    String?
  resolution     String?
  evidence       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator  User              @relation("IncidentCreator", fields: [createdById], references: [id])
  assignee User?             @relation("IncidentAssignee", fields: [assignedUserId], references: [id])
  team     Team?             @relation(fields: [assignedTeamId], references: [id])
  area     Area?             @relation(fields: [areaId], references: [id])
  comments IncidentComment[]

  @@unique([eventId, code])
  @@index([eventId, status])
  @@index([priority])
}

model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([incidentId])
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATIONS & NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Announcement {
  id             String               @id @default(cuid())
  eventId        String
  authorId       String
  title          String
  body           String
  priority       AnnouncementPriority @default(MEDIUM)
  targetAudience Json? // {"scope":"ALL_STAFF"} | {"scope":"TEAMS","teamIds":[]} | {"scope":"ROLES","roleIds":[]}
  createdAt      DateTime             @default(now())

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([eventId, createdAt])
}

enum MessageTarget {
  ALL_STAFF
  TEAM
  USER
}

model Message {
  id              String        @id @default(cuid())
  eventId         String
  senderId        String
  target          MessageTarget @default(ALL_STAFF)
  teamId          String?
  recipientUserId String?
  body            String
  createdAt       DateTime      @default(now())

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([eventId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  eventId   String?
  type      String // TASK_ASSIGNED, INCIDENT_CRITICAL, ANNOUNCEMENT, CREDENTIAL_REVOKED, EVENT_LIVE, MEMBER_ASSIGNED
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────
// PUBLIC SITE — REVIEWS, CONTACT, WHEEL
// ─────────────────────────────────────────────────────────────

model PublicReview {
  id        String   @id @default(cuid())
  author    String
  role      String?
  content   String
  rating    Int      @default(5)
  eventName String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([visible])
}

// Global public-site copy is small and edited as one unit, so a versioned
// JSON document avoids three near-identical CRUD surfaces for team/partners/
// field reports. Only super admins can write it; public reads are read-only.
model SiteContent {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  orgName   String?
  eventType String?
  eventDate String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status])
}

model WheelSpin {
  id         String   @id @default(cuid())
  ip         String   @unique
  spins      Int      @default(0)
  lastReward String?
  lastLabel  String?
  lastCode   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CredentialDeliveryAttempt {
  id                String          @id @default(cuid())
  eventId           String
  ticketId          String
  credentialId      String?
  channel           DeliveryChannel @default(EMAIL)
  status            String          @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  recipient         String?
  provider          String?
  providerMessageId String?
  error             String?
  attempt           Int             @default(1)
  metadata          Json?
  createdById       String?
  createdAt         DateTime        @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket     Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("CredentialDeliveryCreatedBy", fields: [createdById], references: [id])

  @@index([eventId, createdAt])
  @@index([ticketId, createdAt])
  @@index([credentialId])
  @@index([status])
}

enum OutboxEventType {
  RESERVATION_CREATED
  RESERVATION_APPROVED
  RESERVATION_REJECTED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  CREDENTIAL_ISSUED
  EMAIL_SEND
  WEBHOOK_DISPATCH
  ACCESS_CODE_REDEEMED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model OutboxEvent {
  id            String          @id @default(cuid())
  eventType     OutboxEventType
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int             @default(0)
  maxAttempts   Int             @default(5)
  lastError     String?
  scheduledAt   DateTime        @default(now())
  processedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, scheduledAt])
  @@index([eventType, status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// WORKFORCE / RECRUITMENT / ID OPS
// ─────────────────────────────────────────────────────────────

enum WorkforceApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  CONVERTED
  WITHDRAWN
}

model StaffProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  eventId            String?
  nationalId         String?
  workerCode         String?   @unique
  title              String?
  department         String?
  phoneSecondary     String?
  emergencyContact   String?
  notes              String?
  onboardingComplete Boolean   @default(false)
  idCardIssuedAt     DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

model WorkforceApplication {
  id                String                     @id @default(cuid())
  eventId           String
  fullName          String
  email             String?
  phone             String?
  nationalId        String?
  requestedRoleCode String?
  requestedTeamId   String?
  requestedAreaIds  Json?
  source            String?                    @default("manual")
  status            WorkforceApplicationStatus @default(PENDING)
  notes             String?
  reviewNotes       String?
  submittedById     String?
  reviewedById      String?
  convertedUserId   String?
  convertedAt       DateTime?
  metadata          Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submittedBy User? @relation("WorkforceSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User? @relation("WorkforceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([eventId, email])
  @@index([requestedRoleCode])
}

// ─────────────────────────────────────────────────────────────
// INTEGRATIONS / EVENT EXTRAS
// ─────────────────────────────────────────────────────────────

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  url         String
  secret      String?
  events      Json
  active      Boolean  @default(true)
  headers     Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([eventId, active])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  subscriptionId String
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  responseCode   Int?
  responseBody   String?
  error          String?
  attempt        Int                   @default(1)
  createdAt      DateTime              @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([status])
}

model EventInsurancePolicy {
  id              String   @id @default(cuid())
  eventId         String
  provider        String
  policyNumber    String
  coverageDetails String?
  incidentReport  String?
  claimStatus     String   @default("active")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventMapAsset {
  id          String   @id @default(cuid())
  eventId     String   @unique
  map3dUrl    String?
  mapImageUrl String?
  mapPdfUrl   String?
  routeNotes  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model OpsAlert {
  id          String   @id @default(cuid())
  eventId     String
  type        String   @default("help")
  message     String
  teamId      String?
  createdById String?
  resolved    Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([teamId])
}

model TeamChatMessage {
  id        String   @id @default(cuid())
  eventId   String
  teamId    String?
  userId    String?
  text      String
  metadata  Json?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([teamId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  eventId        String?
  actorUserId    String?
  action         String // attendee.updated, ticket.cancelled, ...
  resourceType   String
  resourceId     String?
  previousValue  Json?
  newValue       Json?
  timestamp      DateTime @default(now())
  sourceDevice   String?
  sourceIp       String?
  result         String   @default("SUCCESS")
  metadata       Json?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, timestamp])
  @@index([eventId, timestamp])
  @@index([actorUserId, timestamp])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────
// Transport / bus seat reservation (2D seat map MVP)
// ─────────────────────────────────────────────────────────────

model Bus {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  layout    Json     // { rows, cols, aisleAfterCol, seats: [{label,row,col,state}] }
  seatPrice Decimal  @db.Decimal(10, 2) @default(0)
  currency  String    @default("EGP")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats BusSeat[]

  @@index([eventId])
}

enum SeatState {
  AVAILABLE
  HELD
  RESERVED
  UNAVAILABLE
}

model BusSeat {
  id           String    @id @default(cuid())
  busId        String
  label        String
  row          Int
  col          Int
  state        SeatState @default(AVAILABLE)
  ticketId     String?
  holderName   String?
  passengerName String?
  passengerEmail String?
  passengerPhone String?
  groupId      String?
  holdToken    String?
  holdExpiresAt DateTime?
  reservedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bus    Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([busId, row, col])
  @@index([busId, state])
  @@index([groupId])
  @@index([holdToken])
}

