{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx prisma generate && npm run build",
  "functions": {
    "api/*.js": {
      "includeFiles": "{dist/**,prisma/schema.prisma}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/internal/cleanup/expired-holds",
      "schedule": "0 3 * * *"
    }
  ]
}
