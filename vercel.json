{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx prisma generate && npm run build",
  "outputDirectory": null,
  "functions": {
    "api/*.js": {
      "includeFiles": [
        "dist/**",
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/internal/cleanup/expired-holds",
      "schedule": "*/5 * * * *"
    }
  ]
}
